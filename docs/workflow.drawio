          vertex="1" parent="1">
          <mxGeometry x="175" y="210" width="180" height="55" as="geometry" />
        </mxCell>

        <!-- Initial Health Check -->
        <mxCell id="22" value="&lt;b&gt;Run Initial Health Check&lt;/b&gt;&lt;br&gt;check all APIs immediately&lt;br&gt;(dashboard not empty on load)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="165" y="315" width="200" height="65" as="geometry" />
        </mxCell>

        <!-- Start Background Thread -->
        <mxCell id="23" value="&lt;b&gt;Start Background Thread&lt;/b&gt;&lt;br&gt;daemon thread, runs forever"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="165" y="430" width="200" height="55" as="geometry" />
        </mxCell>

        <!-- Wait 30s (loop marker) -->
        <mxCell id="24" value="&lt;b&gt;Wait 30 Seconds&lt;/b&gt;&lt;br&gt;(CHECK_INTERVAL_SECONDS)"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;dashed=1;strokeWidth=2;"
          vertex="1" parent="1">
          <mxGeometry x="165" y="540" width="200" height="55" as="geometry" />
        </mxCell>

        <!-- For Each API -->
        <mxCell id="25" value="&lt;b&gt;For Each Configured API&lt;/b&gt;&lt;br&gt;CBS · RIVM · HAPI FHIR"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="165" y="650" width="200" height="55" as="geometry" />
        </mxCell>

        <!-- HTTP GET + Retry -->
        <mxCell id="26" value="&lt;b&gt;Send HTTP GET Request&lt;/b&gt;&lt;br&gt;timeout: 10s&lt;br&gt;retry up to 2× on failure"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="155" y="760" width="220" height="65" as="geometry" />
        </mxCell>

        <!-- Classify Status -->
        <mxCell id="27" value="&lt;b&gt;Classify Status&lt;/b&gt;&lt;br&gt;✅ OK: HTTP 200, &lt; 2000ms&lt;br&gt;⚠ SLOW: HTTP 200, &gt; 2000ms&lt;br&gt;🔴 DOWN: error / non-200"
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;"
          vertex="1" parent="1">
          <mxGeometry x="145" y="880" width="240" height="75" as="geometry" />
        </mxCell>

        <!-- Update State + History -->
        <mxCell id="28" value="&lt;b&gt;Update Shared State + History&lt;/b&gt;&lt;br&gt;latest result · last 10 checks&lt;br&gt;(thread-safe lock)"
