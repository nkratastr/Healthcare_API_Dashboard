          vertex="1" parent="1">
          <mxGeometry x="155" y="1010" width="220" height="65" as="geometry" />
        </mxCell>

        <!-- Alert Management -->
        <mxCell id="29" value="&lt;b&gt;Alert Management&lt;/b&gt;&lt;br&gt;SLOW/DOWN → raise alert&lt;br&gt;Recovered to OK → clear alert"
