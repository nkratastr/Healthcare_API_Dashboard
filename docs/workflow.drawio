<mxfile host="app.diagrams.net" version="21.0.0">
  <diagram name="Monitoring Workflow" id="workflow-diagram">
    <mxGraphModel dx="1100" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1050" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ═══ TITLE ═══ -->
        <mxCell id="10" value="Integration Monitor — Monitoring Workflow"
          style="text;html=1;strokeColor=none;fillColor=none;align=center;fontStyle=1;fontSize=17;fontColor=#333333;"
          vertex="1" parent="1">
          <mxGeometry x="150" y="18" width="750" height="40" as="geometry" />
        </mxCell>

        <!-- ═══ SECTION BACKGROUNDS ═══ -->
        <mxCell id="11" value="Background Monitor"
