          <mxGeometry x="580" y="70" width="420" height="700" as="geometry" />
        </mxCell>

        <!-- ═══ BACKGROUND MONITOR FLOW ═══ -->

        <!-- Start -->
        <mxCell id="20" value="&lt;b&gt;START&lt;/b&gt;"
          style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;"
          vertex="1" parent="1">
          <mxGeometry x="185" y="110" width="160" height="50" as="geometry" />
        </mxCell>

        <!-- Flask App Starts -->
        <mxCell id="21" value="&lt;b&gt;Flask App Starts&lt;/b&gt;&lt;br&gt;app.py initialises"
